# Prettier does not read .gitignore, so build output has to be listed again.
# Unanchored where the directory appears per-package, anchored where it does not
# — a bare `supabase/` also matches apps/web/lib/supabase/.
dist/
.next/
.turbo/
coverage/
*.tsbuildinfo
/supabase/
/.supabase/
/graft/
/.playwright-mcp/

# Tool-managed, not project source: Claude Code writes settings.json, and the
# graft helpers and skill are installed by graft and overwritten on update.
/.claude/

# pnpm owns this file's formatting. Reformatting it produces a whole-file diff
# that `pnpm install` then reverts.
/pnpm-lock.yaml

# Real exports, committed verbatim — reformatting one would be editing the
# evidence a parser is tested against. The READMEs are ours. `/**` rather than
# `/`, so the negation can re-include: gitignore syntax cannot bring a file back
# from inside an excluded directory.
/fixtures/**
!/fixtures/**/*.md

# Generated by `pnpm build-card-data`, never hand-edited (§14.1, ADR 002). The
# emitter owns the byte layout; its output is asserted to be stable run to run.
/data/cards/
