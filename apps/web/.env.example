# Local Supabase, as printed by `pnpm db:start`. These are the CLI's published
# demo keys — the same on every machine, and not secrets.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# The canonical address of this deployment, used to build emailed sign-in links
# and the OAuth callback. Leave it unset locally: the request's own origin is
# right, and `next dev` prints it.
#
# Set it in production and set it to the *canonical* site, not to the deployment.
# Vercel gives every preview its own hostname, and a magic link built from one
# points back at that preview — an address Supabase's allow-list rejects and
# nobody meant to share.
#
# It must also be a Site URL or an allow-listed redirect on the Supabase project,
# or GoTrue quietly substitutes its own Site URL. See docs/modules/auth.md.
# NEXT_PUBLIC_SITE_URL=https://planarstandard.vercel.app

# Only needed by code that writes, or that must read past a policy. Never
# reachable from a client bundle — CI fails the build if it becomes so (E1.7).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# The two event calendars, for the /events schedule and the home page's
# next-event tile. Production-only secrets, held in Vercel — leave them unset and
# both pages render from the cache, which on a fresh clone means the seed.
# Nothing else in the site depends on them, and no test needs them.
#
# Each calendar is refreshed independently, so setting one and not the other is a
# working configuration and not a half-configured site.
#
# `CHALLONGE_COMMUNITY` is the community slug from its Challonge URL.
# CHALLONGE_API_KEY=
# CHALLONGE_COMMUNITY=planarstandardmtg
#
# melee.gg's client id and secret, sent as HTTP basic auth.
# MELEE_CLIENT_ID=
# MELEE_CLIENT_SECRET=

# The job routes under /api/jobs (E23.13). Whatever schedules them — Vercel Cron,
# a GitHub Actions curl — sends `Authorization: Bearer $CRON_SECRET`. Unset, every
# job refuses with a 503, which is right for a machine nothing schedules.
# CRON_SECRET=

# OAuth providers (E16.9). Read by the *Supabase* container, not by Next.js, so
# export them in your shell before `pnpm db:start` rather than putting them here
# — `packages/db/supabase.config.toml` substitutes them into the local auth
# config. In production they are set in the Supabase dashboard under
# Authentication → Providers, and no Vercel variable is involved.
#
# None of them is needed. Email and password, and the emailed sign-in link, are
# a complete way in on their own, and the sign-in page only shows the buttons for
# providers the project actually has. Local email goes to Mailpit at
# http://127.0.0.1:54324 rather than anywhere real.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=
