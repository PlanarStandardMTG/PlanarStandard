# Local Supabase, as printed by `pnpm db:start`. These are the CLI's published
# demo keys — the same on every machine, and not secrets.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Only needed by code that writes, or that must read past a policy. Never
# reachable from a client bundle — CI fails the build if it becomes so (E1.7).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Challonge, for the /events schedule. Production-only secrets, held in Vercel —
# leave them unset and `/events` renders from the cache, which on a fresh clone
# means the seed. Nothing else in the site depends on them, and no test needs
# them. `CHALLONGE_COMMUNITY` is the community slug from its Challonge URL.
# CHALLONGE_API_KEY=
# CHALLONGE_COMMUNITY=planarstandardmtg
