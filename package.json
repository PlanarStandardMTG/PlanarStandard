{
  "name": "planar-standard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "depcruise": "depcruise --config .dependency-cruiser.cjs packages apps",
    "guard:server-only": "tsx scripts/check-server-only.ts",
    "new:module": "tsx scripts/new-module.ts",
    "db:start": "pnpm db:setup && supabase start",
    "db:stop": "supabase stop",
    "db:reset": "pnpm db:setup && supabase db reset",
    "dev": "pnpm --filter web dev",
    "db:setup": "tsx scripts/db-setup.ts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "dependency-cruiser": "^16.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.3.0",
    "supabase": "^2.117.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
